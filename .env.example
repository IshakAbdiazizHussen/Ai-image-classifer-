# Copy to .env and fill in real values. Never commit .env itself
# (constraints.md rule 18).

# --- Used when running the backend as a local process (against your own
# Postgres/Redis, however you run them) ---
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/image-classifier
REDIS_URL=redis://localhost:6379/0

# --- Shared by both the local-process and docker-compose workflows ---
# Which promoted model version (a directory under ARTIFACTS_DIR) the
# inference service loads at startup.
MODEL_VERSION=
ARTIFACTS_DIR=ml/artifacts

LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_BYTES=5242880
# Comma-separated (core/config.py's cors_origins_list splits on ","). Both
# localhost and 127.0.0.1 variants of the frontend's dev port are listed —
# browsers treat them as different origins even though they're the same
# machine/port, so a browser that happens to load the frontend via
# 127.0.0.1 instead of localhost would otherwise get a real CORS error.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# --- Used only by `docker compose up` (docker-compose.yml derives
# DATABASE_URL/REDIS_URL from these using in-network service hostnames
# db/redis — not the DATABASE_URL/REDIS_URL above, which are for the
# local-process workflow and point at different hosts/ports) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=image-classifier

# Baked into the frontend's client bundle at `docker compose build` time —
# must be a URL the browser can reach (localhost), not the in-network
# service name "backend".
NEXT_PUBLIC_API_URL=http://localhost:8000
