# Copy to .env and fill in real values. Never commit .env itself
# (constraints.md rule 18).

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/imgclf
REDIS_URL=redis://localhost:6379/0

# Which promoted model version (a directory under ARTIFACTS_DIR) the
# inference service loads at startup.
MODEL_VERSION=
ARTIFACTS_DIR=ml/artifacts

LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_BYTES=5242880
